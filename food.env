# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Add ".env" to your .gitignore.

# --- MarzPay credentials (rotate these immediately since the old ones were exposed) ---
MARZPAY_API_KEY=

MARZPAY_API_SECRET=

# --- MarzPay API base ---
MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1

# --- Your server ---
PORT=4000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Only your real site(s) should be here.
 

# Optional shared secret to verify webhook calls really come from your own
# proxy/edge if you put one in front of this server. Leave blank if unused.
WEBHOOK_VERIFY_TOKEN=
